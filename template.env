# ------------------------------------------------------------------------------
# gwpii — operator environment. Copy to `.env` and fill in. Every value is
# REQUIRED; there are no defaults.
# ------------------------------------------------------------------------------

# The store's Postgres, reached over an ssh tunnel to the pii box's loopback
# (`ssh -L 5440:127.0.0.1:5432 pii-box`). Driver MUST be psycopg v3
# (`+psycopg`): that is the installed driver; a bare `postgresql://` URL
# selects psycopg2, which is absent.
GWPII_DB_URL=postgresql+psycopg://pii:CHANGEME@localhost:5440/pii

# Who you are. Written as `who` on every row of `pii.changes`.
GWPII_OPERATOR=jessica
